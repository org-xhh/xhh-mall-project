{
    "editor.formatOnSave": true, // 保存的时候自动格式化；不打开这个prettier不生效
    // 默认格式化工具选择prettier
    // prettier 格式化 - 后
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    // prettier 和 eslint 可能冲突的规则
    "[javascript]": { 
        "editor.formatOnSave": true 
    }, 
    "[javascriptreact]": {
        "editor.formatOnSave": true
    },
    "[typescript]": {
        "editor.formatOnSave": true
    },
    // eslint 格式化 - 先 
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
}