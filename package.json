    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.3",
    "three": "^0.163.0",
    "vue": "^3.4.21",
    "vue-lazyload": "^3.0.0",
    "vue-qrcode": "^2.2.2",
    "vue-router": "^4.3.0"
